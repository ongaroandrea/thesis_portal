DATABASE_URL=""
# Local directory used for uploaded image binaries. Relative paths are resolved
# from the SvelteKit process working directory.
LOCAL_STORAGE_PATH="./storage"
# Integration tests reset the public schema. This must name a disposable
# database whose name contains "test".
TEST_DATABASE_URL=""

# Server-only connection to the Python conversation queue. Use the same random
# value for PYTHON_SERVER_HMAC_SECRET and the Python server's HMAC_SECRET.
PYTHON_SERVER_URL=""
PYTHON_SERVER_HMAC_SECRET=replace-with-the-python-server-hmac-secret

# Initial verified access accounts created by `npm run db:seed-initial-users`.
# Use two different @polito.it addresses. The password is shared only for the
# initial bootstrap and can be changed normally after the first login.
INITIAL_USERS_PASSWORD=replace-with-a-strong-password
INITIAL_PROFESSOR_EMAIL=professor@polito.it
INITIAL_PROFESSOR_NAME=Initial
INITIAL_PROFESSOR_SURNAME=Professor
INITIAL_ADMIN_EMAIL=admin@polito.it
INITIAL_ADMIN_NAME=Initial
INITIAL_ADMIN_SURNAME=Admin

INITIAL_STUDENT_EMAIL=student@polito.it
INITIAL_STUDENT_NAME=test
INITIAL_STUDENT_SURNAME=test

# Maximum size of one uploaded photo, in MB (in Docker this comes from MAX_IMAGE_MB).
PUBLIC_MAX_IMAGE_MB=5
# true (default): reference images are compressed to WEBP under 350 KB.
PUBLIC_COMPRESS_REFERENCE_IMAGES=true
