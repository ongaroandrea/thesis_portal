# Copy this file to docker.env and replace every placeholder secret.
POSTGRES_DB=thesis_portal
POSTGRES_USER=thesis_user
POSTGRES_PASSWORD=replace-with-a-random-database-password
POSTGRES_PORT=5432

WEB_PORT=5173
# Uploaded images are kept in the Docker-managed local_storage volume at /app/storage.
PUBLIC_URL=http://localhost:5173
BETTER_AUTH_URL=http://localhost:5173
BETTER_AUTH_CLIENT_URL=http://localhost:5173
BETTER_AUTH_SECRET=replace-with-a-long-random-auth-secret

# Python/FastAPI service. Use another random 32-byte secret here.
PYTHON_SERVER_URL=http://image-api:8000
PYTHON_SERVER_HMAC_SECRET=replace-with-a-long-random-secret
API_PORT=8000
HMAC_MAX_AGE_SECONDS=300
QUEUE_MAX_SIZE=100
COMPLETED_JOB_LIMIT=500
MAX_IMAGE_BYTES=12582912
MAX_IMAGE_PIXELS=40000000

# Set true to test the complete stack without calling Ollama.
DEVELOPMENT_MODE=false
OLLAMA_CHAT_URL=http://host.docker.internal:11434/api/chat
OLLAMA_ALLOWED_MODELS=qwen3.8:27b
OLLAMA_TIMEOUT_SECONDS=900
OLLAMA_NUM_CTX=
OLLAMA_NUM_PREDICT=

# Optional SMTP configuration.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=

# Optional initial accounts. Run the seed command documented in DOCKER.md.
INITIAL_USERS_PASSWORD=
INITIAL_PROFESSOR_EMAIL=
INITIAL_PROFESSOR_NAME=Initial
INITIAL_PROFESSOR_SURNAME=Professor
INITIAL_ADMIN_EMAIL=
INITIAL_ADMIN_NAME=Initial
INITIAL_ADMIN_SURNAME=Admin
INITIAL_STUDENT_EMAIL=
INITIAL_STUDENT_NAME=Initial
INITIAL_STUDENT_SURNAME=Student
